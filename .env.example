# Copy to `.env` in the repository root and fill in real values.
# `.env` is gitignored. Never commit a populated `.env`.

# --- MongoDB (Atlas or self-hosted) ---
# Example SRV: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# Example local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB=arohan_st

# --- Session signing secret ---
# Minimum 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start if this is missing or too short.
AUTH_SECRET=
TOKEN_TTL_SECONDS=28800

# --- Bootstrap officer account ---
# Created in the `users` collection on first start only, and never overwritten afterwards.
BOOTSTRAP_OFFICER_EMAIL=
BOOTSTRAP_OFFICER_PASSWORD=
BOOTSTRAP_OFFICER_NAME=MoTA Officer

# --- Password policy for applicant self-registration ---
MIN_PASSWORD_LENGTH=8

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Tesseract OCR (optional overrides) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=eng

# --- Frontend (Vite reads this at build time) ---
VITE_API_URL=http://localhost:8000
