{
  "code": "NOS",
  "external_code": "AZKMI",
  "name": "National Overseas Scholarship Scheme for ST Students",
  "short_description": "Financial assistance for eligible ST students pursuing Master’s, Ph.D. and post-doctoral research abroad.",
  "department": "Ministry of Tribal Affairs, Government of India",
  "degree_level": "Master’s / Ph.D / Post-Doctoral Research abroad",
  "tenure_years": 4,
  "stipend_amount": "Fees, maintenance allowance, contingency, insurance and airfare as specified in revised guideline",
  "source_guideline": "RevisedGuidelinesNOS07102022.pdf (clauses 2.1-4.5)",
  "eligibility_rules": {
    "target_category": "ST",
    "max_annual_income": 600000,
    "min_qualifying_percentage": 55,
    "eligible_degrees": [
      "Master’s",
      "Ph.D",
      "Post-Doctoral Research"
    ],
    "age_limits": {
      "Master’s": 32,
      "Ph.D": 35,
      "Post-Doctoral Research": 38
    }
  },
  "validation_rules": [
    {
      "field": "category",
      "type": "equals",
      "label": "Scheduled Tribe category",
      "severity": "ERROR",
      "value": "ST",
      "expected": "Applicant must belong to the Scheduled Tribe category in their domicile State/UT."
    },
    {
      "field": "annual_family_income",
      "type": "max",
      "label": "Annual family income",
      "severity": "ERROR",
      "value": 600000,
      "expected": "Family income must not exceed ₹6,00,000/year; orphan-supported-by-guardian exemption applies",
      "except_if": {
        "field": "is_orphan",
        "equals": "Yes"
      }
    },
    {
      "field": "course_level",
      "type": "one_of",
      "label": "Course level",
      "severity": "ERROR",
      "values": [
        "Master’s",
        "Ph.D",
        "Post-Doctoral Research"
      ],
      "expected": "Only Master’s, Ph.D and post-doctoral research are covered"
    },
    {
      "field": "applicant_age",
      "type": "max_by_field",
      "label": "Age on 1 July of selection year",
      "severity": "ERROR",
      "expected": "Maximum age depends on course: Master’s 32, Ph.D 35, post-doctoral 38 years",
      "selector_field": "course_level",
      "selector_label": "course level",
      "limits": {
        "Master’s": 32,
        "Ph.D": 35,
        "Post-Doctoral Research": 38
      }
    },
    {
      "field": "qualifying_percentage",
      "type": "min",
      "label": "Qualifying degree marks",
      "severity": "ERROR",
      "value": 55,
      "expected": "Minimum 55% or equivalent, except admission in QS top-1,000 institution; officer must verify ranking",
      "except_if": {
        "field": "qs_top_1000",
        "equals": "Yes"
      }
    },
    {
      "field": "one_child_self_certified",
      "type": "equals",
      "label": "One child per family self-certification",
      "severity": "ERROR",
      "value": "Yes",
      "expected": "One child per family; self-certification required"
    },
    {
      "field": "prior_award",
      "type": "equals",
      "label": "Prior NOS award",
      "severity": "ERROR",
      "value": "No",
      "expected": "Only one NOS award; no second award at same or higher level"
    },
    {
      "field": "admission_stage",
      "type": "one_of",
      "label": "Admission status",
      "severity": "ERROR",
      "values": [
        "Already pursuing",
        "Offer / preliminary offer"
      ],
      "expected": "Already pursuing or offer/preliminary offer required; unconditional-offer requirement is not stated in this guideline"
    }
  ],
  "required_documents": [
    {
      "id": "caste_cert",
      "name": "ST certificate",
      "required": true,
      "description": "ST category proof"
    },
    {
      "id": "dob_proof",
      "name": "10th certificate / marksheet",
      "required": true,
      "description": "Date of birth proof"
    },
    {
      "id": "qualifying_marks",
      "name": "Qualifying degree marksheets",
      "required": true,
      "description": "UG/PG marks, Ph.D completion proof where applicable and CGPA conversion as needed"
    },
    {
      "id": "income_cert",
      "name": "Income certificate",
      "required": true,
      "description": "Income certificate; orphan exception subject to proof"
    },
    {
      "id": "one_child_declaration",
      "name": "One-child self-certification",
      "required": true,
      "description": "Candidate declaration"
    },
    {
      "id": "admission_proof",
      "name": "Foreign university admission proof",
      "required": true,
      "description": "Admission/enrolment or offer evidence"
    },
    {
      "id": "pvtg_proof",
      "name": "PVTG proof (if applicable)",
      "required": false,
      "description": "PVTG category evidence where applicable"
    }
  ],
  "form_fields": [
    {
      "name": "full_name",
      "label": "Applicant full name",
      "type": "text",
      "required": true
    },
    {
      "name": "email",
      "label": "Email",
      "type": "email",
      "required": true
    },
    {
      "name": "phone",
      "label": "Mobile",
      "type": "tel",
      "required": true
    },
    {
      "name": "category",
      "label": "Social category",
      "type": "select",
      "required": true,
      "options": [
        "ST",
        "Other"
      ]
    },
    {
      "name": "course_level",
      "label": "Course level",
      "type": "select",
      "required": true,
      "options": [
        "Master’s",
        "Ph.D",
        "Post-Doctoral Research"
      ]
    },
    {
      "name": "applicant_age",
      "label": "Age on 1 July of selection year",
      "type": "number",
      "required": true
    },
    {
      "name": "annual_family_income",
      "label": "Annual family income (INR)",
      "type": "number",
      "required": false
    },
    {
      "name": "is_orphan",
      "label": "Orphan supported by guardian",
      "type": "select",
      "required": true,
      "options": [
        "No",
        "Yes"
      ]
    },
    {
      "name": "qualifying_percentage",
      "label": "Qualifying degree marks (%)",
      "type": "number",
      "required": false
    },
    {
      "name": "qs_top_1000",
      "label": "Admission in QS top-1,000 institution",
      "type": "select",
      "required": true,
      "options": [
        "No",
        "Yes"
      ]
    },
    {
      "name": "one_child_self_certified",
      "label": "One-child-per-family declaration",
      "type": "select",
      "required": true,
      "options": [
        "No",
        "Yes"
      ]
    },
    {
      "name": "prior_award",
      "label": "Previously received NOS award",
      "type": "select",
      "required": true,
      "options": [
        "No",
        "Yes"
      ]
    },
    {
      "name": "admission_stage",
      "label": "Admission stage",
      "type": "select",
      "required": true,
      "options": [
        "Already pursuing",
        "Offer / preliminary offer"
      ]
    },
    {
      "name": "is_pvtg",
      "label": "PVTG category",
      "type": "select",
      "required": false,
      "options": [
        "No",
        "Yes"
      ]
    },
    {
      "name": "gender",
      "label": "Gender",
      "type": "select",
      "required": false,
      "options": [
        "Female",
        "Male",
        "Other"
      ]
    },
    {
      "name": "foreign_university",
      "label": "Foreign university",
      "type": "text",
      "required": true
    }
  ],
  "selection_notes": [
    "20 awards: 17 ST and 3 PVTG; 30% earmarked for women, with unutilized awards handled as described in guideline.",
    "Selection prioritizes current students at QS top-1,000 institutions by institution rank, then candidates with offers, then remaining eligible candidates through expert interview.",
    "No unconditional-offer-only rule: guideline permits offer/preliminary offer for the later selection stages."
  ],
  "registry_metadata": {
    "delivery_type": "In Others",
    "scheme_type": "Central Sector Scheme",
    "status": "Active"
  }
}
